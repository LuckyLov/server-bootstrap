# Replace quiz.example.com with the approved public hostname or IPv4 address.
# Install only after reviewing the existing shared Nginx/Caddy listeners.

server {
    listen 80;
    listen [::]:80;
    server_name quiz.example.com;

    location ^~ /.well-known/acme-challenge/ {
        root /home/ubuntu/wangqi/data/quiz-king/acme-webroot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name quiz.example.com;

    # Keep certificate state under the wangqi workspace.
    ssl_certificate /home/ubuntu/wangqi/data/quiz-king/certbot/live/quiz.example.com/fullchain.pem;
    ssl_certificate_key /home/ubuntu/wangqi/data/quiz-king/certbot/live/quiz.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}
